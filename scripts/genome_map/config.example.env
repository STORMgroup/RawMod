# RawMod genome-map configuration.
# Copy this file, set the values below, then run:
#   bash scripts/genome_map/submit.sh my_genome.env --dry-run
#   bash scripts/genome_map/submit.sh my_genome.env

# ---- Sample -----------------------------------------------------------------
NAME=my_genome  # prefix for output file names
POD5=/path/to/pod5_dir  # directory containing the .pod5 files (R10.4.1, 5 kHz)
BAM=  # optional: existing dorado BAM made with --emit-moves (skips basecalling)
REF=/path/to/genome.fasta  # reference genome the reads are aligned to
OUT=/path/to/output_dir  # all outputs are written below this directory
TARGET_BASE=T  # base that carries the modification: T (5hmU), A (6mA), C (5mC, 5hmC, 4mC)
STRANDS="+"  # "+" for the forward strand only, "+ -" for both strands
CONTIGS=""  # comma-separated contigs to score; empty = all contigs
CHUNKS=24  # number of parallel featurization jobs

# ---- Model ------------------------------------------------------------------
REPO=/path/to/RawMod
CHECKPOINTS="mixed=$REPO/checkpoints/rawmod.pt"
#   Several models can be scored in one run, as space-separated name=path pairs, e.g.
#   CHECKPOINTS="mixed=$REPO/checkpoints/rawmod.pt loco5hmU=$REPO/checkpoints/region_holdout/loco_5hmU.pt"
PILEUP_MASK_BASES=0  # keep 0 for the released checkpoints

# ---- Featurization (must match training; do not change) ----------------------
MAX_READS=15
MIN_READS=10
MIN_MAPQ=20

# ---- External software ------------------------------------------------------
PYTHON_ENV=/path/to/conda/envs/rawmod  # conda environment with RawMod installed
REFINE_ENV=remora  # conda environment with Remora and samtools
CONDA_SH=/path/to/miniconda3/etc/profile.d/conda.sh
DORADO=/path/to/dorado/bin/dorado
DORADO_MODEL=/path/to/dna_r10.4.1_e8.2_400bps_sup@v5.0.0
# REFINE_PY=$REPO/rawmod/extern/refine_moves_remora.py        # default: the copy shipped in this repository
# LEVELS=$REPO/rawmod/extern/uncalled_r1041_model_only_means.txt   # default: the k-mer level table shipped in this repository
REFINE_SHARDS=16  # number of parallel refinement jobs

# ---- SLURM ------------------------------------------------------------------
SBATCH_CPU="--partition=<cpu_partition>"
SBATCH_GPU="--partition=<gpu_partition> --gres=gpu:1"
